    "Noor. No data yet, open Noor on your iPhone to sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Noch keine Daten, öffne Noor auf deinem iPhone zum Synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. No data yet, open Noor on your iPhone to sync."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Ainda não há dados, abra o Noor no teu iPhone para tincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Данных пока нет, откройте Noor на iPhone для синхронизации."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Aún no hay datos, abra Noor en su iPhone para sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Pas encore de données, ouvrez Noor sur votre iPhone pour synchroniser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Ancora nessun dato, apri Noor sul tuo iPhone per sincronizzare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Nie ma jeszcze danych. Otwórz Noor na swoim iPhonie, aby przeprowadzić synchronizację."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noor。暂无数据，请在 iPhone 上打开 Noor 进行同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noor。暫無資料，請在 iPhone 上開啟 Noor 進行同步。"
          }
        }
      }
    },
    "Noor. Scores out of date, last synced %@. Open Noor on iPhone to refresh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Werte veraltet, zuletzt synchronisiert %@. Öffne Noor auf dem iPhone zum Aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Scores out of date, last synced %@. Open Noor on iPhone to refresh."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NÃO. Pontuações desatualizadas, última sincronização %@. Abra o Noor no iPhone para atualizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Показатели устарели, последняя синхронизация %@. Откройте Noor на iPhone, чтобы обновить."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Resultados fuera de la fecha, último sincronizado %1$@. Abra Noor en iPhone para refrescarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "- Oui. Les scores sont dépassés, le dernier %1$@ synchronisé. Ouvrez Noor sur iPhone pour vous rafraîchir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Punteggi non aggiornati, ultima sincronizzazione %@. Apri Noor su iPhone per aggiornare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noor. Wyniki nieaktualne, ostatnia synchronizacja %@. Otwórz Noor na iPhonie, aby odświeżyć."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noor。评分已过期，上次同步 %@。请在 iPhone 上打开 Noor 以刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noor。評分已過期，上次同步 %@。請在 iPhone 上開啟 Noor 以重新整理。"
          }
        }
      }
    },
