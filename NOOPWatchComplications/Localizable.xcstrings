    "Recovery out of date, last synced %@. Open Noor on iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladung veraltet, zuletzt synchronisiert %@. Öffne Noor auf dem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery out of date, last synced %@. Open Noor on iPhone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga desatualizada, última sincronização %@. Abra o Noor no iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд устарел, последняя синхронизация %@. Откройте Noor на iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga fuera de la fecha, última sincronizada %1$@. Abrir Noor en iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery hors date, dernière synchronisation %1$@. Ouvrez Noor sur iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica non aggiornata, ultima sincronizzazione %@. Apri Noor su iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Energia nieaktualny, ostatnia synchronizacja %@. Otwórz Noor na iPhonie."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量数据已过期，上次同步 %@。请在 iPhone 上打开 Noor。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "能量資料已過期，上次同步 %@。請在 iPhone 上開啟 Noor。"
          }
        }
      }
    },
